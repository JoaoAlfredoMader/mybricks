{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mybricks-api",
  "main": "src/worker.ts",
  // Pin the date: it decides which runtime behaviors the Worker gets. Raise it on purpose, not by accident.
  "compatibility_date": "2026-11-01",
  // Better Auth, the PDF generator and the e-mail/storage drivers use Node APIs (Buffer, crypto, async hooks).
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // pdfkit's browser build resolves an ICC profile path from import.meta.url at load time, which is not
  // a valid URL inside a Worker bundle and made the Worker fail to start. The profile is only read for
  // PDF/A documents, which contract-pdf.ts does not produce; any valid URL does.
  "define": { "import.meta.url": "\"file:///worker/index.js\"" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mybricks",
      "database_id": "7ace96ca-b2b8-4833-b126-b205253e8490",
      // The same .sql files Drizzle generates; `npm run db:deploy` applies them.
      "migrations_dir": "migrations"
    }
  ],

  // Photos, documents and contract PDFs. Create the bucket once: `npx wrangler r2 bucket create mybricks-files`.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "mybricks-files" }],

  // Housekeeping (expired demos, orphan files, audit retention): the Node server runs it on a timer.
  "triggers": { "crons": ["0 * * * *"] },

  // Public settings. Secrets (BETTER_AUTH_SECRET, RESEND_API_KEY)
  // go in with `npx wrangler secret put <NAME>`; locally they live in api/.dev.vars (see .dev.vars.example).
  "vars": {
    "NODE_ENV": "production",
    "BETTER_AUTH_URL": "https://mybricks.com.br",
    "FRONTEND_URL": "https://mybricks.com.br",
    "EMAIL_DRIVER": "resend",
    "EMAIL_FROM": "MyBricks <nao-responder@mybricks.com.br>",
    "MAINTENANCE_INTERVAL_MINUTES": "0"
  },

  // The API answers on the real domain under /api/*; the front-end Worker owns everything else, so the
  // browser sees ONE origin (cookies and no CORS). The zone has to be on Cloudflare, with a proxied DNS record for the host.
  "routes": [{ "pattern": "mybricks.com.br/api/*", "zone_name": "mybricks.com.br" }],

  // Homologation: same code, its own database, bucket and host. `npx wrangler deploy --env staging`.
  // Nothing is inherited for these keys, so each one is repeated. Never point it at production data.
  "env": {
    "staging": {
      "name": "mybricks-api-staging",
      "define": { "import.meta.url": "\"file:///worker/index.js\"" },
      "routes": [{ "pattern": "staging.mybricks.com.br/api/*", "zone_name": "mybricks.com.br" }],
      "triggers": { "crons": ["0 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mybricks-staging",
          "database_id": "e0422c86-7a4b-4b4e-87f7-e07503fd0164",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "mybricks-files-staging" }],
      "vars": {
        "NODE_ENV": "production",
        "BETTER_AUTH_URL": "https://staging.mybricks.com.br",
        "FRONTEND_URL": "https://staging.mybricks.com.br",
        "EMAIL_DRIVER": "resend",
        "EMAIL_FROM": "MyBricks Homologação <nao-responder@mybricks.com.br>",
        "MAINTENANCE_INTERVAL_MINUTES": "0"
      }
    }
  }
}
