# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (SQLite) ───────────────────────────────────────────────────────
# A local SQLite file for the Node server, the scripts and the tests. On Cloudflare the Worker uses the D1
# binding "DB" (wrangler.jsonc) and ignores this. Create the file with `npm run db:migrate`.
DATABASE_URL=file:.data/mybricks.db

# -- Better Auth --------------------------------------------------------------
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# Guest/demo workspace lifetime
DEMO_TTL_HOURS=24
# Optional Google sign-in (leave unset to disable)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# -- Object storage (photos, documents, contract PDFs) -------------------------
# local: files in a folder (development). s3: any S3-compatible bucket (R2, B2, MinIO, AWS...).
STORAGE_DRIVER=local
STORAGE_DIR=.data/storage
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# Largest accepted upload, in megabytes
MAX_UPLOAD_MB=15

# Public for-sale listings: the platform's WhatsApp, where every listing card leads (wa.me format: 55 + area code + number, digits only, 12-13)
LISTINGS_WHATSAPP_NUMBER=5548991802046

# -- E-mail (account confirmation) --------------------------------------------
# log: the message is printed in the API console (development). resend: sent through Resend; required in production.
EMAIL_DRIVER=log
# RESEND_API_KEY=re_...
# Sender: the domain has to be verified in Resend (DNS records), e.g. mybricks.com.br
# EMAIL_FROM=MyBricks <nao-responder@mybricks.com.br>
# EMAIL_REPLY_TO=contato@mybricks.com.br
# Wait for the confirmation link before the first sign-in. Defaults to true with resend and false with log.
# REQUIRE_EMAIL_VERIFICATION=false

# How often the housekeeping (expired demos, orphan files, audit retention, stale sessions) runs, in minutes; 0 = off
MAINTENANCE_INTERVAL_MINUTES=60
