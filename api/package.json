{
  "name": "@mybricks/api",
  "version": "0.1.0",
  "private": true,
  "description": "MyBricks API: real-estate portfolio management (Hono, Prisma, PostgreSQL, Better Auth).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "admin:create": "tsx --env-file=.env src/scripts/create-platform-admin.ts",
    "build": "tsc -p tsconfig.build.json",
    "db:deploy": "wrangler d1 migrations apply DB --remote",
    "db:fetch-cities": "tsx src/scripts/fetch-cities.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/scripts/migrate.ts",
    "db:migrate:worker": "wrangler d1 migrations apply DB --local",
    "db:reference-data": "tsx src/scripts/generate-reference-data.ts",
    "db:studio": "drizzle-kit studio",
    "deploy": "wrangler deploy",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:worker": "wrangler dev",
    "maintenance": "tsx --env-file=.env src/scripts/maintenance.ts",
    "openapi:export": "tsx src/scripts/export-openapi.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@hono/node-server": "^2.1.6",
    "@libsql/client": "^0.18.0",
    "@scalar/hono-api-reference": "^0.12.17",
    "better-auth": "^1.7.15",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "htmlparser2": "^12.0.0",
    "pdfkit": "^0.20.2",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@scalar/openapi-parser": "^0.29.19",
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.7",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
